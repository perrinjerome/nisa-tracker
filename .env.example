# OpenAI-compatible chat API used by the dashboard AI assistant (/api/chat).
# Copy this file to .env and fill in your values.
# Real environment variables always take precedence over this file.
OPENAI_API_URL=
OPENAI_API_TOKEN=
# Optional: default is gpt-4o-mini
# OPENAI_API_MODEL=gpt-4o-mini   # optional: default model (models are selectable in the UI)
# Optional: sandbox time limit for python_eval in seconds (default 15)
# PYTHON_EVAL_TIMEOUT=15